# Public canonical origin (production domain).
NEXT_PUBLIC_SITE_URL=https://tuquipu.com
# Product login URL (footer "Ingresar al sistema" link; hidden while empty).
NEXT_PUBLIC_APP_LOGIN_URL=
# Lead delivery. Both must be set for real submissions to be sent.
LEAD_WEBHOOK_URL=
LEAD_PRIVACY_APPROVED=false

# Account lookup for "Ingresar": receives ?identificador=<RUC o correo> and redirects to the company login.
NEXT_PUBLIC_ACCOUNT_LOOKUP_URL=
